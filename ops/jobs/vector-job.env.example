VIBELO_REPO_ROOT=/opt/vibelo
VIBELO_VECTOR_PYTHON=/opt/vibelo/.venv-vector/bin/python

# Every embedding artifact must use a new collection and vector version.
VIBELO_EMBED_MODEL=google/siglip2-base-patch16-224
VIBELO_EMBED_MODEL_PATH=/data/vibelo-models/google__siglip2-base-patch16-224
VIBELO_EMBED_PROJECTION_VERSION=siglip-image-feature-l2-rp512-seed20260606-v1
VIBELO_EMBED_VECTOR_VERSION=siglip2-base-p224-d512-v2-public
VIBELO_MILVUS_COLLECTION=vibelo_image_vectors_siglip2_base_p224_d512_v2_public
VIBELO_MILVUS_HOST=127.0.0.1
VIBELO_MILVUS_PORT=19530

# Model libraries are offline and may write only below /data.
MODEL_CACHE_ROOT=/data/vibelo-vector/cache
VIBELO_HF_HOME=/data/vibelo-vector/cache/huggingface
TORCH_HOME=/data/vibelo-vector/cache/torch
VIBELO_TORCH_HOME=/data/vibelo-vector/cache/torch
XDG_CACHE=/data/vibelo-vector/cache/xdg
XDG_CACHE_HOME=/data/vibelo-vector/cache/xdg
VIBELO_REQUIRE_DATA_CACHE=1
VIBELO_MODEL_OFFLINE=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
VIBELO_USE_HF_PROXY=0

VIBELO_EMBED_DEVICE=cpu
VIBELO_EMBED_BATCH_SIZE=2
VIBELO_EMBED_LIMIT=2000
VIBELO_EMBED_REQUIRE_INDEX_COUNT_MATCH=1
VIBELO_VECTOR_READY_MARKER=/data/vibelo-vector/state/ready.json
VIBELO_REQUIRE_VECTOR_READY_MARKER=1
VIBELO_BACKEND_BASE_URL=http://127.0.0.1

# The installer replaces this loopback placeholder with the backend Compose
# bridge gateway after proving host.docker.internal resolves to that address.
VIBELO_VECTOR_RECALL_HOST=127.0.0.1
VIBELO_VECTOR_RECALL_PORT=8091
VIBELO_VECTOR_RECALL_MAX_LIMIT=240
VIBELO_REQUIRE_PRIVATE_BRIDGE_BIND=1

# The current 7.1 GiB ECS must not install this workload. Use >= 15 GiB.
VIBELO_VECTOR_MIN_TOTAL_MEMORY_KB=15728640
VIBELO_VECTOR_MIN_AVAILABLE_MEMORY_KB=6291456

# 内容任务的最小环境。复制到 /etc/vibelo/content-job.env 后填写秘密值，
# 权限保持 0640 root:vibelo-jobs。不要放短信、Token 或其他无关密钥。
VIBELO_REPO_ROOT=/opt/vibelo
VIBELO_CONTENT_JOB_ROOT=/data/vibelo-ingest
VIBELO_CONTENT_PYTHON=/opt/vibelo/.venv-content/bin/python
VIBELO_OPS_PYTHON=/opt/vibelo/.venv-ops/bin/python

VIBELO_DB_HOST=replace_with_rds_internal_endpoint
VIBELO_DB_PORT=3306
VIBELO_DB_NAME=rangwaz_image_dev
VIBELO_DB_USER=vibelo_app
VIBELO_DB_PASSWORD=replace_me

VIBELO_MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace_me
MINIO_SECRET_KEY=replace_me
MINIO_BUCKET=rangwaz-media
VIBELO_ES_URL=http://127.0.0.1:9200
VIBELO_ES_INDEX=rangwaz-images

# 公网 timer 永久禁止浏览器采集；授权图片必须在本地人工采集并同步到 staging。
# 安装器、预检和运行脚本都会拒绝把这个值改成 true。
VIBELO_CONTENT_COLLECT_ENABLED=false
VIBELO_CONTENT_IMPORT_ENABLED=true
VIBELO_CONTENT_SEARCH_REINDEX_ENABLED=true

# 导入资源门禁。公网不执行 collector，因此不配置滚动、浏览器或下载并发参数。
VIBELO_CONTENT_MIN_FREE_BYTES=26843545600
VIBELO_CONTENT_MIN_AVAILABLE_MEMORY_KB=1048576

# 使用已存在的业务作者；不要在这里写用户密码。
VIBELO_IMPORT_USERNAME=mira
VIBELO_IMPORT_LIMIT=500
VIBELO_IMPORT_RECURSIVE=false
VIBELO_IMPORT_RESUME=true
VIBELO_IMPORT_PROCESSED_DIR=/data/vibelo-ingest/dataset/processed
VIBELO_MEDIA_OBJECT_PREFIX=/api/media/object
VIBELO_IMPORT_MAX_FILE_BYTES=26214400
VIBELO_IMPORT_MAX_IMAGE_PIXELS=40000000
VIBELO_IMPORT_MAX_IMAGE_DIMENSION=16384

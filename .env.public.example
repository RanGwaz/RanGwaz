# Copy this file to .env.public, replace every replace_me value, and never commit it.
PUBLIC_HTTP_PORT=80
# TLS remains disabled unless docker-compose.public.tls.yml is explicitly added.
# Keep the certificate directory outside Git. It must contain fullchain.pem and
# privkey.pem; the TLS overlay mounts it read-only.
PUBLIC_HTTPS_PORT=443
VIBELO_TLS_CERT_DIR=/data/vibelo-tls
# Keep this placeholder until configure-rds-env.sh writes the real origin.
# After ICP filing and before TLS enablement, set it to https://vibelo.xin.
# For owner-only IP testing, temporarily use http://<ECS-public-IP>; do not
# invite real users to log in over that plaintext origin.
APP_WEB_ALLOWED_ORIGIN_PATTERNS=https://www.example.com
APP_AUTH_TOKEN_SECRET=replace_with_at_least_32_random_characters
APP_MODERATION_TOKEN=replace_with_a_distinct_32_character_random_secret
APP_AUTH_TOKEN_TTL_SECONDS=86400

# Set these two values to the same full Git SHA after importing a verified
# offline release bundle. Empty values keep the local `latest` build defaults.
VIBELO_BACKEND_IMAGE=
VIBELO_FRONTEND_IMAGE=

# Public deployment uses an Alibaba Cloud RDS MySQL 8.0/8.4 internal endpoint by default.
# Keep ECS and RDS in the same VPC, allow the ECS private IP in the RDS whitelist,
# and enable RDS SSL when possible. sslMode=PREFERRED also permits an initial
# connection before SSL is enabled; change it to REQUIRED after enabling SSL.
SPRING_DATASOURCE_URL=jdbc:mysql://replace_with_rds_internal_endpoint:3306/rangwaz_image_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&sslMode=PREFERRED&connectTimeout=5000&socketTimeout=10000&tcpKeepAlive=true
SPRING_DATASOURCE_USERNAME=vibelo_app
SPRING_DATASOURCE_PASSWORD=replace_me

# Optional local fallback only. These are ignored unless compose is started with
# --profile local-database. To use it, also point SPRING_DATASOURCE_URL at
# jdbc:mysql://mysql:3306/rangwaz_image_dev and set all passwords below.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=rangwaz_image_dev
MYSQL_USER=rangwaz
MYSQL_PASSWORD=
MYSQL_HOST_PORT=3306

MINIO_ACCESS_KEY=replace_me
MINIO_SECRET_KEY=replace_me
MINIO_BUCKET=rangwaz-media
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Real SMS is the default. Set APP_SMS_MOCK=true only for a local test.
APP_SMS_MOCK=false
ALIYUN_SMS_ACCESS_KEY_ID=replace_me
ALIYUN_SMS_ACCESS_KEY_SECRET=replace_me
ALIYUN_SMS_SIGN_NAME=replace_me
ALIYUN_SMS_TEMPLATE_CODE=100001

# Fast first release: user publishing/upload and automatic content moderation
# remain disabled. APP_MODERATION_TOKEN is only for manual review over the ECS
# loopback interface; never send it over the temporary plaintext public origin.
# Enable recommendation services only after their local health checks pass.
VECTOR_ENABLED=false
VECTOR_SERVICE_URL=http://host.docker.internal:8091
SIMILAR_MIN_COSINE_SCORE=0.20
MODEL_RECALL_ENABLED=false
MODEL_RANKING_ENABLED=false
MODEL_SERVICE_URL=http://host.docker.internal:8092

VIBELO_MILVUS_HOST=127.0.0.1
VIBELO_MILVUS_PORT=19530
VIBELO_RECOMMENDATION_HOST=127.0.0.1
VIBELO_RECOMMENDATION_PORT=8092
VIBELO_RECOMMENDATION_MODEL_DIR=/opt/vibelo/models/recommendation
VIBELO_TWO_TOWER_DEVICE=cpu
VIBELO_TWO_TOWER_RETRY_SECONDS=30
VIBELO_MILVUS_COLLECTION=vibelo_image_vectors_siglip2_base_p224_d512

# Python training/index jobs use their own RDS connection variables.
VIBELO_DB_HOST=replace_with_rds_internal_endpoint
VIBELO_DB_PORT=3306
VIBELO_DB_NAME=rangwaz_image_dev
VIBELO_DB_USER=vibelo_app
VIBELO_DB_PASSWORD=replace_me

# The public frontend image is always built with this same-origin gateway prefix.
VITE_API_BASE=/api

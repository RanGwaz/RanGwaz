# Copy to a server-side secret store or an untracked .env file.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/rangwaz_image?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
SPRING_DATASOURCE_USERNAME=replace_me
SPRING_DATASOURCE_PASSWORD=replace_me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_me
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Use the exact public frontend origin. For same-origin /api proxy, use the site origin.
APP_WEB_ALLOWED_ORIGIN_PATTERNS=https://www.example.com
APP_AUTH_TOKEN_SECRET=replace_with_at_least_32_random_characters
APP_AUTH_TOKEN_TTL_SECONDS=86400
APP_MODERATION_TOKEN=replace_me
APP_FEATURE_PUBLISHING_ENABLED=true

ALIYUN_PNVS_SMS_ACCESS_KEY_ID=replace_me
ALIYUN_PNVS_SMS_ACCESS_KEY_SECRET=replace_me
ALIYUN_PNVS_SMS_SIGN_NAME=replace_me
ALIYUN_PNVS_SMS_TEMPLATE_CODE=replace_me

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=replace_me
MINIO_SECRET_KEY=replace_me
MINIO_BUCKET=rangwaz-media
APP_STORAGE_MINIO_OBJECT_URL_PREFIX=https://img.example.com

ELASTICSEARCH_URL=http://127.0.0.1:9200
VECTOR_SERVICE_URL=http://127.0.0.1:8091
MODEL_SERVICE_URL=http://127.0.0.1:8092
VIBELO_MILVUS_HOST=127.0.0.1
VIBELO_MILVUS_PORT=19530
VIBELO_RECOMMENDATION_HOST=127.0.0.1
VIBELO_RECOMMENDATION_PORT=8092
VIBELO_RECOMMENDATION_MODEL_DIR=/opt/vibelo/models/recommendation
VIBELO_TWO_TOWER_DEVICE=cpu
VIBELO_TWO_TOWER_RETRY_SECONDS=30
VIBELO_MILVUS_COLLECTION=vibelo_image_vectors_siglip2_base_p224_d512

# Python training/index jobs do not read SPRING_DATASOURCE_URL.
VIBELO_DB_HOST=127.0.0.1
VIBELO_DB_PORT=3306
VIBELO_DB_NAME=rangwaz_image
VIBELO_DB_USER=replace_me
VIBELO_DB_PASSWORD=replace_me

# Frontend build-time value. Same-origin deployment should keep this as /api.
VITE_API_BASE=/api
